# PRIVATE BETA environment — copy to .env.beta ON THE SERVER. Never commit real values. Names only here.
BETA_DOMAIN=beta.example.com
BETA_DB_PASSWORD=
BACKUP_RETENTION_DAYS=14

# Auth + encryption (generate fresh; back up the keys separately from DB backups — see runbook)
BETTER_AUTH_SECRET=
FLOWLINE_ENCRYPTION_KEY=
# Separate key ring for platform credentials (/admin). Must differ from FLOWLINE_ENCRYPTION_KEY.
FLOWLINE_PLATFORM_ENCRYPTION_KEY=

# Access: invitation-only (sign-up requires an invitation or a beta code)
FLOWLINE_BETA_MODE=invite_only
# Sign-up allowlist only — never authorization. Platform admins: scripts/admin/bootstrap.mts (runbook §2a).
FLOWLINE_BETA_ADMINS=

# AI: nothing to set here. Workspace owners connect their own AI provider keys in Settings → AI Providers
# (never via env). Platform-funded AI is not implemented and needs separate owner approval.

# Email, billing keys/plans, sign-in and integration OAuth apps, and the email recipient allowlist are entered by a
# platform admin at /admin (encrypted in the DB, never read from env at runtime). Upgrading from an env-configured
# beta: keep the old variables until each is imported once in /admin ("Import from environment"), then delete them.

# Billing safety gates stay here (SANDBOX ONLY in this phase; live payments need owner approval)
FLOWLINE_BILLING_PADDLE_ENV=sandbox

# Monitoring — FLOWLINE_OPS_TOKEN: 32+ random chars; the monitor service and /api/ops/status use it
FLOWLINE_OPS_TOKEN=
FLOWLINE_OPS_BACKUP_DIR=/backups
FLOWLINE_OPS_DATA_DIR=/backups
FLOWLINE_SENTRY_DSN=
FLOWLINE_ALERT_WEBHOOK_URL=
