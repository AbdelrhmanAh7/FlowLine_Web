# PRIVATE BETA environment — copy to .env.beta ON THE SERVER. Never commit real values. Names only here.
BETA_DOMAIN=beta.example.com
BETA_DB_PASSWORD=
BACKUP_RETENTION_DAYS=14

# Auth + encryption (generate fresh; back up FLOWLINE_ENCRYPTION_KEY separately from DB backups — see runbook)
BETTER_AUTH_SECRET=
FLOWLINE_ENCRYPTION_KEY=

# Access: invitation-only (sign-up requires an invitation or a beta code)
FLOWLINE_BETA_MODE=invite_only
FLOWLINE_BETA_ADMINS=

# AI: nothing to set here. Workspace owners connect their own AI provider keys in Settings → AI Providers
# (never via env). Platform-funded AI is not implemented and needs separate owner approval.

# Email (sandbox guard: only these recipients until the owner approves customer email)
FLOWLINE_EMAIL_PROVIDER=resend
FLOWLINE_EMAIL_RESEND_KEY=
FLOWLINE_EMAIL_FROM=
FLOWLINE_EMAIL_ALLOWED_RECIPIENTS=

# Billing — SANDBOX ONLY in this phase
FLOWLINE_BILLING_PROVIDER=paddle
FLOWLINE_BILLING_PADDLE_ENV=sandbox
FLOWLINE_BILLING_PADDLE_KEY=
FLOWLINE_BILLING_PADDLE_WEBHOOK_SECRET=
# Public client-side token for Paddle.js on /billing/checkout (sandbox: test_…). Not an API key.
FLOWLINE_BILLING_PADDLE_CLIENT_TOKEN=
FLOWLINE_BILLING_PLANS=
FLOWLINE_BILLING_FREE_PLAN=

# Sign-in + integrations (test OAuth apps with beta redirect URIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Monitoring — FLOWLINE_OPS_TOKEN: 32+ random chars; the monitor service and /api/ops/status use it
FLOWLINE_OPS_TOKEN=
FLOWLINE_OPS_BACKUP_DIR=/backups
FLOWLINE_OPS_DATA_DIR=/backups
FLOWLINE_SENTRY_DSN=
FLOWLINE_ALERT_WEBHOOK_URL=
