{
	auto_https off
	admin off
}

# No host ports. Only the dedicated cloudflared connector network may reach this origin listener.
# TLS is terminated at Cloudflare; never use the direct-ingress Caddyfile for this HTTP origin.
http://{$BETA_DOMAIN}:8080 {
	encode zstd gzip
	# Allow the supported 5 MiB upload plus multipart overhead; bound request admission.
	request_body {
		max_size 6MiB
	}
	@internal path /api/test/* /api/debug/* /api/ops/* /_next/webpack-hmr*
	respond @internal 404
	@missingVisitorIp not header CF-Connecting-IP *
	respond @missingVisitorIp 403

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Request-Id {http.request.uuid}
		-Server
	}
	@sensitive path /api/oauth/callback /api/auth/callback/* /api/sso/callback /admin /admin/* /api/platform/*
	header @sensitive {
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
		defer
	}
	reverse_proxy web:3000 {
		header_up X-Request-Id {http.request.uuid}
		# Trust this header only because there is no direct ingress and the connector network is dedicated.
		# Before exposure prove spoofed client X-Real-IP/X-Forwarded-* do not reach the app.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {$BETA_DOMAIN}
		flush_interval -1
	}
	log {
		output stdout
		format filter {
			request>uri regexp "([?&](?:token|code|state|error|error_description|error_uri)=)[^&]*|(/invite/)[^/?]*|(/api/hooks/)[^/?]*" "${1}${2}${3}REDACTED"
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			wrap json
		}
	}
}
