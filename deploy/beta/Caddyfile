# Socket-level upload deadline, including stalled/chunked bodies, before Next.js.
# Keep read_body aligned with BODY_READ_TIMEOUT_MS in src/server/http.ts.
{
	servers {
		# Caddy 2.10 does not pass these read deadlines to its HTTP/3 server.
		protocols h1 h2
		timeouts {
			read_header 5s
			read_body 10s
		}
	}
}

# Declare port 80 so it also receives servers.timeouts; Caddy's implicit redirect
# server is created after global server options are applied.
http://{$BETA_DOMAIN} {
	redir https://{$BETA_DOMAIN}{uri} 308
}

# Automatic HTTPS (Let's Encrypt) for the beta domain. Only this proxy is public.
{$BETA_DOMAIN} {
	encode zstd gzip

	# Install byte limits before reverse_proxy reads/forwards the body (also for chunked uploads).
	# Limits layer by minimum. Only these two exact collection routes escape the 1 MiB default;
	# knowledge JSON text submissions retain the same budget as multipart uploads.
	@ordinary_body not path_regexp ^/api/workspaces/[^/]+/(files|knowledge)/?$
	request_body @ordinary_body {
		max_size 1MiB
	}
	@upload_body path_regexp ^/api/workspaces/[^/]+/(files|knowledge)/?$
	request_body @upload_body {
		max_size 5308416
	}
	@public_body path_regexp ^/api/(email|beta/check)/?$
	request_body @public_body {
		max_size 16KiB
	}
	@auth_body path_regexp ^/api/auth(/|$)
	request_body @auth_body {
		max_size 64KiB
	}
	@webhook_body path_regexp ^/api/(hooks/[^/]+|billing/webhook)/?$
	request_body @webhook_body {
		max_size 256KiB
	}
	@platform_body path_regexp ^/api/platform(/|$)
	request_body @platform_body {
		max_size 16KiB
	}
	@credential_body path_regexp ^/api/(platform/setup(/|$)|workspaces/[^/]+/oauth-apps/[^/]+/?$)
	request_body @credential_body {
		max_size 8KiB
	}

	# Internal-only endpoints are never exposed through the proxy.
	@internal path /api/test/* /api/debug/* /api/ops/* /_next/webpack-hmr*
	respond @internal 404

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Same id the app receives (header_up below) — every response carries it, not only API routes.
		X-Request-Id {http.request.uuid}
		-Server
	}

	# OAuth / sign-in callbacks carry authorization codes and state in the URL; the platform admin panel handles secrets.
	# Never leak their URLs through Referer, never cache them (CREDENTIALS_DESIGN MUST 21). `defer` makes this the
	# final value even over the app's own headers.
	@sensitive path /api/oauth/callback /api/auth/callback/* /api/sso/callback /admin /admin/* /api/platform/*
	header @sensitive {
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
		defer
	}

	reverse_proxy web:3000 {
		header_up X-Request-Id {http.request.uuid}
		# The app keys per-IP limits on X-Real-IP: always overwrite it with the real peer so a client can't spoof it.
		header_up X-Real-IP {remote_host}
	}

	# Email links (verify/reset/delete ?token=…), invitation links (/invite/<token>) and webhook URLs
	# (/api/hooks/<token>) carry bearer secrets; OAuth callbacks carry `code`, `state` and provider `error*` values:
	# redact them all from the access log, and drop Referer (same URLs).
	log {
		output stdout
		format filter {
			request>uri regexp "([?&](?:token|code|state|error|error_description|error_uri)=)[^&]*|(/invite/)[^/?]*|(/api/hooks/)[^/?]*" "${1}${2}${3}REDACTED"
			request>headers>Referer delete
			wrap json
		}
	}
}
