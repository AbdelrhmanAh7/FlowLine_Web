# Copy to .env (dev) — no real secrets belong in this file.
DATABASE_URL=postgres://flowline:flowline_local_only@localhost:5433/flowline
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-64-hex-chars
BETTER_AUTH_URL=http://localhost:3000
# "development" | "test". Test-only features (fault injection, seed) require FLOWLINE_ENV=test.
FLOWLINE_ENV=development

# OAuth is optional. Leave empty and the buttons show "Not configured" and stay disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32-byte base64 key for credential encryption. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLOWLINE_ENCRYPTION_KEY=
# Previous keys (comma-separated) kept only to decrypt old secrets during rotation.
FLOWLINE_ENCRYPTION_KEYS_OLD=
# Exact host:port pairs that may be reached despite being private/loopback (e.g. a dedicated DB). No ranges.
FLOWLINE_EGRESS_ALLOWLIST=
# AI provider. "ollama" (local) or "anthropic"/"openai" when their API keys are set.
FLOWLINE_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
FLOWLINE_AI_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OAuth apps (optional). Without them the provider shows "OAuth not configured".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Public base URL used in webhook URLs and OAuth redirects.
FLOWLINE_PUBLIC_URL=http://localhost:3000

# Live/sandbox suite (pnpm test:live) — OPTIONAL. Use dedicated sandbox/test accounts only.
# Each value is JSON of that provider's connect fields; missing → the check is reported BLOCKED.
# FLOWLINE_LIVE_SLACK={"token":"xoxb-…"}
# FLOWLINE_LIVE_GOOGLE_SHEETS={"token":"<OAuth access token>"}
# FLOWLINE_LIVE_GMAIL={"token":"<OAuth access token>"}
# FLOWLINE_LIVE_HUBSPOT={"token":"<private app token>"}
# FLOWLINE_LIVE_ZENDESK={"email":"…","token":"…","subdomain":"…"}
# FLOWLINE_LIVE_AIRTABLE={"token":"…"}
# FLOWLINE_LIVE_SNOWFLAKE={"accountUrl":"https://<acct>.snowflakecomputing.com","token":"<PAT>"}
# FLOWLINE_LIVE_GITHUB={"token":"…"}
# FLOWLINE_LIVE_STRIPE={"token":"sk_test_…"}
# FLOWLINE_LIVE_NOTION={"token":"…"}
# FLOWLINE_LIVE_LINEAR={"token":"…"}
#
# Certification suite (REL-LIVE-SUITE, pnpm test:live:saas) — OPTIONAL. Per provider, also:
# FLOWLINE_LIVE_<PROVIDER>_TARGET = JSON of dedicated test resource ids, e.g.
# FLOWLINE_LIVE_GOOGLE_SHEETS_TARGET={"spreadsheetId":"…","tab":"FlowlineCert"}
# FLOWLINE_LIVE_SLACK_TARGET={"channel":"C0…"}
# FLOWLINE_LIVE_GITHUB_TARGET={"owner":"…","repo":"…","issue":"1","pr":"1"}
# FLOWLINE_LIVE_AIRTABLE_TARGET={"baseId":"app…","table":"…","field":"Name"}
# FLOWLINE_LIVE_NOTION_TARGET={"parentPageId":"…"}
# FLOWLINE_LIVE_LINEAR_TARGET={"teamId":"…"}
# FLOWLINE_LIVE_<PROVIDER>_REVOKED = same JSON shape as the credentials, for a revoked/invalid
# credential of the same provider (drives the revocation check). Stripe: sk_test_ keys only.
# Full shapes and scopes: docs/integrations/LIVE-CERTIFICATION.md
# Dry-run against the local test double (no credentials needed): pnpm test:live:dryrun
