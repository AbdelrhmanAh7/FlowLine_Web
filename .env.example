# Copy to .env (dev) — no real secrets belong in this file.
# Use 127.0.0.1, not localhost: on Windows + WSL2 + Docker Desktop, "localhost" resolves to ::1 first, which goes through
# wslrelay.exe and intermittently timed out (P3-15, artifacts/phase-3/p3-15/INVESTIGATION.md). 127.0.0.1 goes straight to Docker.
DATABASE_URL=postgres://flowline:flowline_local_only@127.0.0.1:5433/flowline
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-64-hex-chars
BETTER_AUTH_URL=http://localhost:3000
# "development" | "test". Test-only features (fault injection, seed) require FLOWLINE_ENV=test.
FLOWLINE_ENV=development
# TEST ONLY (#124): "1" creates new e-mail sign-ups already verified (no verification e-mail), for external automated
# testers. Ignored, with a configuration error in the log, unless FLOWLINE_ENV=test. Never set on beta or production.
FLOWLINE_TEST_AUTO_VERIFY=

# Optional platform ZITADEL sign-in application. This complete server-only tuple takes precedence over the legacy
# encrypted platform DB configuration; if all three are blank, that DB configuration remains available. A partial
# tuple disables ZITADEL sign-in (it never falls back). Keep the client secret private and restart web processes after
# changing these values. Workspace SSO is configured separately.
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# ─── Other service credentials are NOT configured here ─────────────────────────────────────────────────────────
# Google/GitHub sign-in apps, the Google/Slack/GitHub integration OAuth apps, the email provider key + sender, the
# email recipient allowlist, billing (Stripe test / Paddle sandbox) keys, webhook secrets, client token, the active
# billing provider and the plans are managed by a PLATFORM ADMIN in the app (/admin), stored encrypted in the DB and
# read per operation (rotation needs no restart). The runtime NEVER reads them from the environment.
# First admin: scripts/admin/bootstrap.mts (see docs/implementation/PRIVATE_BETA_RUNBOOK.md, "Platform admin").
# Upgrading an installation that used env vars: set them ONCE here, then use "Import from environment" per purpose in
# /admin (explicit, audited, once), then REMOVE them — the panel lists any that are still set:
#   GOOGLE_CLIENT_ID/SECRET, GITHUB_CLIENT_ID/SECRET (sign-in) · GOOGLE_/SLACK_/GITHUB_OAUTH_CLIENT_ID/SECRET (integrations)
#   FLOWLINE_EMAIL_PROVIDER/FROM/RESEND_KEY/POSTMARK_TOKEN/ALLOWED_RECIPIENTS
#   FLOWLINE_BILLING_PROVIDER/STRIPE_KEY/WEBHOOK_SECRET/PADDLE_KEY/PADDLE_WEBHOOK_SECRET/PADDLE_CLIENT_TOKEN/PLANS/FREE_PLAN
# Note: while FLOWLINE_EMAIL_ALLOWED_RECIPIENTS is set but not imported, NO email is sent (the sandbox is never widened).

# 32-byte base64 key for WORKSPACE credential encryption (connections, SSO, webhooks, step data, AI keys, workspace
# OAuth apps). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FLOWLINE_ENCRYPTION_KEY=
# Previous keys (comma-separated) kept only to decrypt old secrets during rotation (then run scripts/admin/rewrap.mts).
FLOWLINE_ENCRYPTION_KEYS_OLD=
# SEPARATE 32-byte base64 key ring for PLATFORM credentials (the admin panel). Required to use /admin; must differ from
# every FLOWLINE_ENCRYPTION_KEY(S) value. Rotate the same way (…_OLD + scripts/admin/rewrap.mts).
FLOWLINE_PLATFORM_ENCRYPTION_KEY=
FLOWLINE_PLATFORM_ENCRYPTION_KEYS_OLD=
# Exact host:port pairs that may be reached despite being private/loopback (e.g. a dedicated DB). No ranges.
FLOWLINE_EGRESS_ALLOWLIST=
# AI: there is NO model-provider configuration here. Each workspace owner connects their own provider keys in
# the app (Settings → AI Providers); keys are encrypted with FLOWLINE_ENCRYPTION_KEY and never read from env.
# Model-provider variables (FLOWLINE_AI_PROVIDER, FLOWLINE_AI_MODEL, ANTHROPIC_API_KEY, OPENAI_API_KEY, OLLAMA_*)
# are ignored if set, and are never imported into workspaces. Local inference (Ollama) is not supported.
# Public base URL used in webhook URLs and OAuth redirects (the admin panel shows the exact redirect URIs from it).
FLOWLINE_PUBLIC_URL=http://localhost:3000

# Account email: the provider, sender and key are set in /admin. Locally (and on the test/staging stacks only) the
# DB outbox can stand in for a provider — it is refused in any other production build.
FLOWLINE_EMAIL_PROVIDER=outbox

# Billing safety gates stay OPERATOR environment (never a click in the panel). Keys, the provider and the plans are set
# in /admin (Stripe test mode / Paddle SANDBOX only). Live payments need explicit owner approval.
FLOWLINE_BILLING_PADDLE_ENV=sandbox
FLOWLINE_BILLING_ALLOW_LIVE=

# Live/sandbox suite (pnpm test:live) — OPTIONAL. Use dedicated sandbox/test accounts only.
# Each value is JSON of that provider's connect fields; missing → the check is reported BLOCKED.
# FLOWLINE_LIVE_SLACK={"token":"xoxb-…"}
# FLOWLINE_LIVE_GOOGLE_SHEETS={"token":"<OAuth access token>"}
# FLOWLINE_LIVE_GMAIL={"token":"<OAuth access token>"}
# FLOWLINE_LIVE_HUBSPOT={"token":"<private app token>"}
# FLOWLINE_LIVE_ZENDESK={"email":"…","token":"…","subdomain":"…"}
# FLOWLINE_LIVE_AIRTABLE={"token":"…"}
# FLOWLINE_LIVE_SNOWFLAKE={"accountUrl":"https://<acct>.snowflakecomputing.com","token":"<PAT>"}
# FLOWLINE_LIVE_GITHUB={"token":"…"}
# FLOWLINE_LIVE_STRIPE={"token":"sk_test_…"}
# FLOWLINE_LIVE_NOTION={"token":"…"}
# FLOWLINE_LIVE_LINEAR={"token":"…"}
#
# Certification suite (REL-LIVE-SUITE, pnpm test:live:saas) — OPTIONAL. Per provider, also:
# FLOWLINE_LIVE_<PROVIDER>_TARGET = JSON of dedicated test resource ids, e.g.
# FLOWLINE_LIVE_GOOGLE_SHEETS_TARGET={"spreadsheetId":"…","tab":"FlowlineCert"}
# FLOWLINE_LIVE_SLACK_TARGET={"channel":"C0…"}
# FLOWLINE_LIVE_GITHUB_TARGET={"owner":"…","repo":"…","issue":"1","pr":"1"}
# FLOWLINE_LIVE_AIRTABLE_TARGET={"baseId":"app…","table":"…","field":"Name"}
# FLOWLINE_LIVE_NOTION_TARGET={"parentPageId":"…"}
# FLOWLINE_LIVE_LINEAR_TARGET={"teamId":"…"}
# FLOWLINE_LIVE_<PROVIDER>_REVOKED = same JSON shape as the credentials, for a revoked/invalid
# credential of the same provider (drives the revocation check). Stripe: sk_test_ keys only.
# Full shapes and scopes: docs/integrations/LIVE-CERTIFICATION.md
# Dry-run against the local test double (no credentials needed): pnpm test:live:dryrun

# Private beta support channels shown in the user menu (unset = shown disabled with a reason)
FLOWLINE_SUPPORT_EMAIL=
# Optional https:// feedback form; otherwise "Report an issue" opens an email to FLOWLINE_SUPPORT_EMAIL
FLOWLINE_FEEDBACK_URL=
